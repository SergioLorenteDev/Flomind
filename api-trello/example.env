# Plantilla de credenciales para el API.
#
#   cp example.env .env
#
# Spring Boot carga automaticamente api-trello/.env (ver spring.config.import en
# application.yaml) y ese fichero esta ignorado por git, asi que tus valores
# nunca se versionan.

# --- Obligatorio: clave de firma de los JWT (Base64) ---
# Genera la tuya y anadela al final de tu .env:
#   printf 'JWT_SECRET_KEY=%s\n' "$(openssl rand -base64 64 | tr -d '\n')" >> .env
# JWT_SECRET_KEY=

# --- Obligatorio para que arranque la app ---
# Los valores de Google y Stripe de aqui abajo son marcadores de ejemplo: la app
# arranca con ellos, pero sustituyelos por los tuyos para usar esos servicios.
BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=000000000000-localdev.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-localdev-not-a-real-secret
STRIPE_SECRET_KEY=sk_test_localdev

# --- Base de datos local ---
# application.yaml usa root en localhost:3306/trello; deja vacio si no hay contrasena.
MYSQL_PASSWORD=

# --- Webhook de Stripe (whsec_...) ---
STRIPE_WEBHOOK_SECRET=

# --- Correo SMTP (opcional) ---
# Sin estos valores el registro sigue funcionando: el envio de correo se omite y
# puedes confirmar la cuenta con el token guardado en la base de datos.
MAIL_USERNAME=
MAIL_PASSWORD=
